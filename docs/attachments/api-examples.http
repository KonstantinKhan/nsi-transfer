### =====================================================================
###  Примеры ошибок (ProblemDetails, application/problem+json)
### =====================================================================

#  400 ConfigurationValidationException (PUT конфигурации):
#  {
#    "title": "Ошибка валидации конфигурации",
#    "detail": "Параметр 'StartSyncWithIntervalMinutes' (Интервал...) должен быть больше 0.; ...",
#    "errors": { "AppConfiguration": ["..."] }
#  }

#  409 Conflict при повторном запуске:
#  {
#    "title": "Попытка запуска синхронизации во время выполнения другой синхронизации",
#    "detail": "Синхронизация уже запущена. Дождитесь завершения текущего процесса..."
#  }

#  500 Internal Server Error:
#  {
#    "message": "Произошла внутренняя ошибка сервера.",
#    "details": "<в Dev — полный stack; в Prod — сообщение с временем>",
#    "traceId": "<TraceIdentifier>"
#  }


### =====================================================================
###  Формат SendingModel (ответ S.1/S.2/S.3/S.4)
### =====================================================================
#  {
#    "id": "11111111-2222-3333-4444-555555555555",
#    "initiatedAt": "2026-08-06T12:00:00.000Z",
#    "endedAt": "2026-08-06T12:00:42.000Z",
#    "initiatorName": "Фоновый сервис",
#    "statusId": 3,           // SendingStatusEnum
#    "targetReferenceNodeName": "Коды",
#    "messages": [
#      {
#        "id": 123,
#        "startedCollectionFromPolynomAt": "...",
#        "finishedCollectionFromPolynomAt": "...",
#        "sentAtQueue": "...",
#        "polynomObjectsAmountInMessage": 42,
#        "publishingResultId": 1,    // RabbitMqPublishingResultEnum
#        "messageType": 1,           // MessageTypeEnum
#        "messageFailure": null      // MessageFailureModel | null
#      }
#    ]
#  }


### =====================================================================
###  SSE-события (ответ S.5/S.6) — формат кадра
### =====================================================================
#  event: <EventType>
#  data: {"sendingId":"<GUID>","eventType":"<EventType>","payload":{ ... }}
#
#  Поддерживаемые EventType:
#    StatusChanged      — смена статуса Sending (payload: { status, sendingModel?, endedAt? })
#    MessageCreated     — создан новый Message в БД (payload: { id, startedCollectionFromPolynomAt, pageNumber })
#    MessageEmpty       — страница поиска пуста, Message удалён (payload: { id })
#    ObjectsCollected   — завершён сбор свойств объектов (payload: { id, objectsCount, finishedCollectionFromPolynomAt })
#    MessagePublished   — успешная публикация в RabbitMQ (payload: { id, sentAtQueue })
#    MessageFailed      — сбой сообщения (payload: { id, error, errorStatus })
#    SendingCompleted   — отправление завершено успешно (payload: { endedAt })
#    RetryMessageCreated / RetryObjectsCollected / RetryMessagePublished / RetryMessageEmpty
#    Error              — критическая ошибка (payload: { message })
#    Closed             — сервер закрыл поток конкретного Sending
#
#  Heartbeat (только для listen-for-sync-events): строка ": heartbeat\n\n" каждые 15 сек.
