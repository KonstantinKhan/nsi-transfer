# ============================================================
# NsiTransfer — переменные окружения
# Скопируйте: cp .env.example .env  — и заполните значения.
# Формат имён: Секция__Поле (двойное подчёркивание) — стандарт ASP.NET Core.
# ============================================================

# --- Режим бэка: Production (без Swagger) или Development (Swagger на /swagger) ---
ASPNETCORE_ENVIRONMENT=Production

# --- Порты хоста ---
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ------------------------------------------------------------
# PostgreSQL (внешний сервер)
# Формат: Host=...;Port=...;Database=...;Username=...;Password=...;Include Error Detail=true
# ------------------------------------------------------------
ConnectionStrings__DefaultConnection=Host=192.168.0.10;Port=5432;Database=nsi_transfer;Username=postgres;Password=CHANGE_ME;Include Error Detail=true

# ------------------------------------------------------------
# Полином (удалённый сервер API)
# Address — базовый URL, слэш в конце не нужен. Пример: http://172.23.14.181
# ------------------------------------------------------------
PolynomConfig__Address=http://172.23.14.181
PolynomConfig__DbName=CHANGE_ME
PolynomConfig__TimeZoneId=Russian Standard Time

PolynomAuthCreds__Username=CHANGE_ME
PolynomAuthCreds__Password=CHANGE_ME

# ------------------------------------------------------------
# RabbitMQ (внешний)
# ------------------------------------------------------------
RabbitMqCreds__Host=192.168.0.10
RabbitMqCreds__Port=5672
RabbitMqCreds__Username=CHANGE_ME
RabbitMqCreds__Password=CHANGE_ME
RabbitMqCreds__VirtualHost=/

# ------------------------------------------------------------
# SMTP (email-уведомления об ошибках)
# ------------------------------------------------------------
SmtpSettings__Server=smtp.example.ru
SmtpSettings__Port=587
SmtpSettings__SenderName=NsiTransfer
SmtpSettings__SenderEmail=nsitransfer@example.ru
SmtpSettings__Username=CHANGE_ME
SmtpSettings__Password=CHANGE_ME
SmtpSettings__UseSsl=true

# ------------------------------------------------------------
# Фронт: адрес API бэка, как его видит БРАУЗЕР пользователя.
# Читается контейнером в рантайме (docker-entrypoint.sh генерирует /config.json
# при старте), НЕ запекается в бандл при сборке. После смены значения достаточно
# пересоздать контейнер, пересборка образа не нужна:
#   docker compose up -d --force-recreate nsitransferfront
# Примеры:
#   http://localhost:8080/api            (запуск на той же машине)
#   http://192.168.0.50:8080/api         (запуск на машине 192.168.0.50, вход с другой машины)
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
